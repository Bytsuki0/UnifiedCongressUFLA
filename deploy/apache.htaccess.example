# Congresso Unificado ICTIN — exemplo de configuração Apache.
#
# Copie para a raiz do diretório publicado (a saída de `npm run build`)
# com o nome `.htaccess`. Exige `AllowOverride All` no VirtualHost e o
# módulo mod_rewrite habilitado.
#
# Sem isto, recarregar a página em /estudante/historico devolve 404: o
# Apache procura um arquivo nesse caminho e a aplicação é client-side.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Arquivos e diretórios que existem de verdade são servidos como
  # estão (/assets/*, /robots.txt, /favicon.svg).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Qualquer outra rota entrega o index.html, mantendo a URL.
  RewriteRule ^ index.html [L]
</IfModule>

# Áreas autenticadas: bloqueio real de indexação.
<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/(estudante|revisor|admin|co-chairs)(/|$)" PRIVADO=1
  # /congresso inteiro: área congelada, hoje só para admin.
  SetEnvIf Request_URI "^/congresso(/|$)" PRIVADO=1
  # Verificação de e-mail: /confirmar-email é pública, mas leva token na URL.
  SetEnvIf Request_URI "^/(confirmar-email|verifique-email)(/|$)" PRIVADO=1
  Header set X-Robots-Tag "noindex, nofollow" env=PRIVADO

  <FilesMatch "\.(js|css|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
