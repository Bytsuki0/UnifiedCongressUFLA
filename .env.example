# ============================================================
# Nexus Corp — Environment Variables (EXAMPLE — placeholders only)
# ============================================================
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# IMPORTANT — secret handling rules:
#   * .env may contain ONLY browser-safe values (VITE_*).
#   * SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ACCESS_TOKEN and the DB
#     password are SECRETS. Do not put them in .env on a dev
#     machine. Keep them in a CI/deploy secret store and export
#     them as environment variables only for `npm run migrate` /
#     `npm run seed:admin`, e.g.:
#
#       SUPABASE_ACCESS_TOKEN=... npm run migrate
# ============================================================

# ------ Supabase project (Settings → API) ------------------

# Your Supabase project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Anon / publishable key (safe to expose in the browser)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXX

# ------ Storage (envio de PDFs dos trabalhos) --------------

# Bucket de Storage usado para os PDFs dos trabalhos (privado).
VITE_SUPABASE_PDF_BUCKET=Pdfs
