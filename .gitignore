# Build de deploy (Cloudflare Pages) — mesmas regras do .env: só VITE_*,
# nunca service_role. O .env.example é o que fica versionado.
.env.production
vite_project
# Claude Code: só o settings.json do projeto (allowlist compartilhada) é versionado;
# settings.local.json e o resto de .claude/ ficam locais.
.claude/*
!.claude/settings.json
# Instruções locais do Claude — não versionar (pedido do time)
