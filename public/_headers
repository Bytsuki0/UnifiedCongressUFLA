# Netlify / Cloudflare Pages — cabeçalhos por caminho.
#
# X-Robots-Tag é o bloqueio de indexação de verdade (o robots.txt só
# impede a visita do robô, não a indexação da URL). Como a aplicação é
# client-side, não há como emitir <meta name="robots"> por rota — o
# cabeçalho HTTP resolve isso no servidor.
#
# Quando mais de uma regra casa com o mesmo caminho, o Pages aplica todas.
# Por isso a regra /* traz só cabeçalhos de segurança (sem Cache-Control):
# um Cache-Control aqui colidiria com o de /assets/*.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Sem includeSubDomains de propósito: em *.workers.dev o cabeçalho vale
  # só para este host, e não queremos falar pelo domínio inteiro.
  # NÃO substitui o "Always Use HTTPS" da zona: o HSTS só protege a
  # PARTIR da segunda visita; a primeira requisição em http continua em
  # claro até a zona redirecionar.
  Strict-Transport-Security: max-age=31536000

# O shell da SPA nunca pode ser cacheado: ele carrega /assets/index-<hash>.js.
# Se o index.html ficar velho no cache, o navegador pede um hash que não
# existe mais depois do deploy seguinte e a página quebra em branco.
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/estudante/*
  X-Robots-Tag: noindex, nofollow
/revisor/*
  X-Robots-Tag: noindex, nofollow
/admin/*
  X-Robots-Tag: noindex, nofollow
/co-chairs/*
  X-Robots-Tag: noindex, nofollow
/congresso/admin/*
  X-Robots-Tag: noindex, nofollow
/congresso/dashboard
  X-Robots-Tag: noindex, nofollow
/congresso/inscricao
  X-Robots-Tag: noindex, nofollow
/congresso/minicursos
  X-Robots-Tag: noindex, nofollow
/congresso/certificados
  X-Robots-Tag: noindex, nofollow
/congresso/perfil
  X-Robots-Tag: noindex, nofollow

# Verificação de e-mail: a primeira é pública mas leva token na URL, a
# segunda exige sessão. Nenhuma das duas deve entrar em índice de busca.
/confirmar-email
  X-Robots-Tag: noindex, nofollow
/verifique-email
  X-Robots-Tag: noindex, nofollow

/assets/*
  Cache-Control: public, max-age=31536000, immutable
